{
  "manifest_version": 3,
  "name": "Redirect Stopper",
  "version": "1.0.0",
  "description": "Blocks unsolicited pop-ups and click-hijacking overlays.",
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["redirect-guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ]
}
